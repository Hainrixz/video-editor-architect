{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/claude-editor/**)",
      "Read(~/Library/Application Support/claude-editor/estudio-chrome/**)",
      "Read(//**/ig_cookies.txt)",
      "Read(//**/cookies.txt)"
    ],
    "ask": [
      "Bash(*--si-gasto*)",
      "mcp__apify__*"
    ]
  },
  "enabledPlugins": {
    "ui-ux-pro-max@video-editor-architect": true,
    "hyperframes@video-editor-architect": true,
    "brag@video-editor-architect": true,
    "watch@video-editor-architect": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "video-editor-architect": {
      "source": {
        "source": "settings",
        "name": "video-editor-architect",
        "owner": {
          "name": "video-editor-architect"
        },
        "plugins": [
          {
            "name": "ui-ux-pro-max",
            "description": "Design intelligence: palettes, font pairings and design tokens (MIT, nextlevelbuilder).",
            "source": {
              "source": "github",
              "repo": "nextlevelbuilder/ui-ux-pro-max-skill",
              "sha": "67803eac81607188194aea9842a723b89326d90d"
            }
          },
          {
            "name": "hyperframes",
            "description": "HTML-to-video framework skills by HeyGen (Apache-2.0).",
            "source": {
              "source": "github",
              "repo": "heygen-com/hyperframes",
              "sha": "e1925d4317fcd13c0e5799cd4767a3e2dd4c9238"
            }
          },
          {
            "name": "brag",
            "description": "Launch videos with HyperFrames, plus /brag-slim (MIT, Shunit Haviv Hakimi).",
            "source": {
              "source": "github",
              "repo": "latent-spaces/brag",
              "sha": "8531ccb9f471ef5099abf930079e47b55c55bb21"
            }
          },
          {
            "name": "watch",
            "description": "Let Claude watch a reference video: frames + transcript (MIT, Bradley Bonanno).",
            "source": {
              "source": "github",
              "repo": "bradautomates/claude-video",
              "sha": "03ceb42f7fa2c4439aca01752118044baabffb8f"
            }
          }
        ]
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/vigilar-bash.mjs\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": [
        "~/.config/claude-editor",
        "~/Library/Application Support/claude-editor/estudio-chrome"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "/tmp/claude-501/tsx-501",
        "/private/tmp/claude-501/tsx-501"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "www.instagram.com",
        "*.cdninstagram.com",
        "*.fbcdn.net",
        "fonts.gstatic.com",
        "kenney.nl",
        "*.kenney.nl"
      ]
    },
    "excludedCommands": [
      "npx tsx herramientas/doctor.ts",
      "npx tsx herramientas/doctor.ts *",
      "npx tsx herramientas/grabador/estudio.ts *",
      "npx tsx herramientas/grabador/ventana.ts *",
      "npx remotion render *",
      "npx remotion still *",
      "npx remotion benchmark *",
      "npx tsx herramientas/render.ts *",
      "npx tsx herramientas/qa.ts *",
      "npx tsx herramientas/transcribir.ts *",
      "npx tsx herramientas/emparejar.ts",
      "npx tsx herramientas/emparejar.ts *",
      "npx tsx herramientas/cara.ts *",
      "npx tsx herramientas/editar.ts *",
      "npx tsx herramientas/estilo/medir.ts *",
      "npx tsx herramientas/estilo/medir-capas.ts *",
      "npx tsx herramientas/estilo/overlays.ts *",
      "npx tsx herramientas/estilo/aprender.ts *",
      "npx tsx herramientas/stickers/procesar.ts *",
      "npx tsx pruebas/integracion/*",
      "npx playwright-cli *"
    ],
    "credentials": {
      "envVars": [
        {
          "name": "GEMINI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GOOGLE_API_KEY",
          "mode": "deny"
        },
        {
          "name": "APIFY_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}
